NODE_ENV=production
PORT=3000
APP_ORIGIN=https://weekly.example.com
TRUST_PROXY=false
DATABASE_PATH=./data/zhoubao.sqlite
BACKUP_DIR=./data/backups
UPLOAD_DIR=./data/uploads
HOLIDAY_DATA_DIR=./data/holidays
SESSION_COOKIE_NAME=zhoubao_session
SESSION_TTL_DAYS=30
DEV_AUTH_BYPASS=false
EMAIL_AUTH_ENABLED=false
# Required when enabling email auth; generate a random secret of at least 32 characters.
EMAIL_CODE_SECRET=
MAILX_PATH=mailx

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
