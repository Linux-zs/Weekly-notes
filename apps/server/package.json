{
  "name": "@zhoubao/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development DEV_AUTH_BYPASS=true HOST=127.0.0.1 tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:backup": "tsx src/scripts/backup.ts",
    "holiday:import": "tsx src/scripts/import-holidays.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@zhoubao/shared": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "date-fns": "^4.1.0",
    "fastify": "^5.5.0",
    "jose": "^6.1.0",
    "openid-client": "^6.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
